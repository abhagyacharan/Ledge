{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ledge-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "ledge-dev-node",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/next/dist/bin/next", "dev", "--port", "3200"],
      "port": 3200,
      "autoPort": false,
      "env": {
        "NEXT_DIST_DIR": ".next-e2e",
        "BETTER_AUTH_URL": "http://localhost:3200"
      }
    }
  ]
}
