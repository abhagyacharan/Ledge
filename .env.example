# App
DATABASE_URL=postgres://ledge:ledge@localhost:5433/ledge
BETTER_AUTH_SECRET=             # long random string (e.g. `openssl rand -base64 32`)
BETTER_AUTH_URL=http://localhost:3000
ALLOW_SIGNUP=true
TZ=Asia/Kolkata

# Postgres container (docker-compose.yml). Must match DATABASE_URL.
POSTGRES_USER=ledge
POSTGRES_PASSWORD=ledge
POSTGRES_DB=ledge
