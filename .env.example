# App
DATABASE_URL=postgres://ledge:ledge@localhost:5433/ledge
BETTER_AUTH_SECRET=             # long random string (e.g. `openssl rand -base64 32`)
BETTER_AUTH_URL=http://localhost:3000
ALLOW_SIGNUP=true
TZ=Asia/Kolkata
# Only when a proxy sits in front of the app (Cloudflare Tunnel sets cf-connecting-ip). Leave empty locally.
CLIENT_IP_HEADER=

# Google sign-in (docs/auth-google-reset-spec.md). Both empty: no "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Password-reset emails through Resend. Empty in development: the link is printed in the dev
# server's console instead. Empty in production: "Forgot password?" is hidden.
RESEND_API_KEY=
EMAIL_FROM=                     # e.g. Ledge <no-reply@yourdomain.com>, on a domain verified in Resend

# Voice capture (docs/voice-spec.md). Leave GROQ_API_KEY empty to turn voice off.
# VOICE_FAKE=1 answers from built-in examples instead of calling Groq (trying it without a key).
GROQ_API_KEY=
VOICE_FAKE=
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# GROQ_PARSE_MODEL=openai/gpt-oss-120b
# VOICE_DAILY_LIMIT=30   # voice requests per person per day; a spoken command is 2

# Task reminders (docs/reminders-spec.md): Web Push keys. Make a pair with `pnpm push:keys`.
# All three set, or reminders stay off. VAPID_SUBJECT is a mailto: or https: contact for the push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Postgres container (docker-compose.yml). Must match DATABASE_URL.
POSTGRES_USER=ledge
POSTGRES_PASSWORD=ledge
POSTGRES_DB=ledge
