# Settings for the SERVER (docs/deploy-guide.md). On the server: cp .env.production.example .env
# then fill in every value that is empty. Never commit the real .env.

# Database password. Use only letters and digits (it goes inside a web address):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs your login cookies. At least 32 characters:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address you will open in the browser: https, no slash at the end.
BETTER_AUTH_URL=https://ledge.example.com

# true only until you have created your own account. Then set false and run:
#   docker compose up -d
ALLOW_SIGNUP=true

# Leave EMPTY when the server already runs a Cloudflare tunnel (Ledge is added to it as a route,
# docs/deploy-guide.md step 6). Only for a machine without one: the tunnel token (starts "ey").
TUNNEL_TOKEN=

# Backups are written as this user so you can read and copy them. Run `id -u` and `id -g`.
BACKUP_UID=1000
BACKUP_GID=1000

# Voice capture: your Groq API key (console.groq.com). Leave empty to keep voice off.
# Your voice and the words go to Groq; read Groq's data policy first (docs/voice-spec.md §10).
GROQ_API_KEY=

# Optional (these are the defaults):
# POSTGRES_USER=ledge
# POSTGRES_DB=ledge
# TZ=Asia/Kolkata
# BACKUP_AT=21:00          # UTC. 21:00 UTC is 02:30 in India
# APP_PORT=3000            # port on this machine only (127.0.0.1)
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# GROQ_PARSE_MODEL=openai/gpt-oss-120b
# VOICE_DAILY_LIMIT=300    # voice requests per person per day
