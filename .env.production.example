# Settings for the SERVER (docs/deploy-guide.md). On the server: cp .env.production.example .env
# then fill in every value that is empty. Never commit the real .env.

# Database password. Use only letters and digits (it goes inside a web address):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs your login cookies. At least 32 characters:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address you will open in the browser: https, no slash at the end.
BETTER_AUTH_URL=https://ledge.example.com

# true only until you have created your own account. Then set false and run:
#   docker compose up -d
ALLOW_SIGNUP=true

# From the Cloudflare dashboard when you create the tunnel (a long text starting "ey").
TUNNEL_TOKEN=

# Backups are written as this user so you can read and copy them. Run `id -u` and `id -g`.
BACKUP_UID=1000
BACKUP_GID=1000

# Optional (these are the defaults):
# POSTGRES_USER=ledge
# POSTGRES_DB=ledge
# TZ=Asia/Kolkata
# BACKUP_AT=21:00          # UTC. 21:00 UTC is 02:30 in India
# APP_PORT=3000            # port on this machine only (127.0.0.1)
